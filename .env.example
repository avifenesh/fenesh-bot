# /etc/fenesh-bot/env on the host (0640 root:fenesh). Never commit the real file.
METACULUS_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
# Optional
# ASKNEWS_API_KEY=
# EXA_API_KEY=
# Optional extra alert channel (plain-text POST, bearer token if set). The owner gets alerts through
# deploy/alert-relay.sh, which needs neither.
# FENESH_ALERT_WEBHOOK=
# FENESH_ALERT_TOKEN=
# FENESH_ASKNEWS_TIMEOUT_MS=15000
# Hours AskNews stays off after a 402 (empty wallet); the owner is alerted once per empty spell.
# FENESH_ASKNEWS_402_HOURS=6
# Spacing between Metaculus API requests, ms (one queue per process).
# FENESH_METACULUS_GAP_MS=1000
# FENESH_WEBSEARCH_BIN=/usr/local/bin/harness-websearch-cli
FENESH_DAILY_BUDGET_USD=60
FENESH_MAX_COST_PER_QUESTION=4
FENESH_TOURNAMENTS=fall-futureeval-2026
FENESH_MINIBENCH=1
FENESH_DRY_RUN=0
